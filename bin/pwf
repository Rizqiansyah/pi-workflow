#!/usr/bin/env bash
# pwf — pixi-backed python for the pi milestone workflow.
#
# pi's pixi-python-block extension deliberately blocks bare python/python3,
# so workflow tooling that must run under a pixi-managed interpreter uses
# this shim instead. It runs python from the workflow's own pixi
# environment, keeping the "python must use pixi" rule intact.
set -euo pipefail

WF_PIXI="${WF_PIXI:-$HOME/.pi/agent/workflow/.pixi}"

# pixi >= 0.61 uses .pixi/envs/default/bin; older pixi used .pixi/bin
if [[ -x "$WF_PIXI/envs/default/bin/python" ]]; then
  PYTHON="$WF_PIXI/envs/default/bin/python"
elif [[ -x "$WF_PIXI/bin/python" ]]; then
  PYTHON="$WF_PIXI/bin/python"
else
  echo "pwf: workflow pixi env not found under $WF_PIXI" >&2
  echo "pwf: run 'cd ~/.pi/agent/workflow && pixi install' first" >&2
  exit 127
fi

exec "$PYTHON" "$@"
